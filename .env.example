# Public HTTPS deployment URL, no trailing slash
PUBLIC_BASE_URL=https://your-deployment.example.com
PORT=3000

# Twilio - never commit real values
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+10000000000
# Keep true for live testing. Set false only for isolated troubleshooting.
TWILIO_VALIDATE_SIGNATURE=true

# OpenAI
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5

# Razorpay (use Test Mode keys for first end-to-end test)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me

# Google Calendar - temporary OAuth access token for V0 test deployment
GOOGLE_CALENDAR_ACCESS_TOKEN=replace_me
GOOGLE_CALENDAR_ID=primary

# Single-tenant V0 test configuration
TEST_TENANT_ID=demo-clinic
ADMIN_API_KEY=replace_with_long_random_value
APPOINTMENT_MINUTES=30
BUSINESS_DAY_START_HOUR=9
BUSINESS_DAY_END_HOUR=18
CALENDAR_HORIZON_DAYS=7
STAFF_NOTIFY_PHONE=+10000000001

# Optional: full ClientConfig JSON. If omitted, server starts with safe demo defaults.
# TENANT_CONFIG_JSON={"tenantId":"demo-clinic","name":"Demo Clinic","timezone":"Asia/Kolkata","contactWithinSeconds":180,"paymentRequired":true,"bookingFeeMinor":100,"currency":"INR","reminderOffsetsMinutes":[1440,180,30],"escalationKeywords":["human","doctor","complaint","refund","emergency"],"approvedKnowledge":[]}
