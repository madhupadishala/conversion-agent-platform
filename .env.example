# Public HTTPS deployment URL, no trailing slash
PUBLIC_BASE_URL=https://your-deployment.example.com
PORT=3000

# Validation telephony: Twilio trial
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+10000000000
TWILIO_VALIDATE_SIGNATURE=true

# Governed conversation model: Sarvam
SARVAM_API_KEY=replace_me
SARVAM_CHAT_MODEL=sarvam-30b

# Future production telephony option: Plivo (not used by the validation server yet)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# Razorpay (use Test Mode keys for first end-to-end test)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me

# Google Calendar
GOOGLE_CALENDAR_ACCESS_TOKEN=replace_me
GOOGLE_CALENDAR_ID=primary

# Single-tenant V0 dental validation configuration
TEST_TENANT_ID=demo-dental-hospital
ADMIN_API_KEY=replace_with_long_random_value
APPOINTMENT_MINUTES=30
BUSINESS_DAY_START_HOUR=9
BUSINESS_DAY_END_HOUR=18
CALENDAR_HORIZON_DAYS=7
STAFF_NOTIFY_PHONE=+910000000000

# Load config/dental-demo.json into TENANT_CONFIG_JSON at deployment time.
# Never commit real API keys, patient/customer data, or personal phone numbers.
