# Public HTTPS deployment URL, no trailing slash
PUBLIC_BASE_URL=https://your-deployment.example.com
PORT=3000

# Validation telephony: Twilio trial
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace_me
TWILIO_FROM_NUMBER=+10000000000
# For temporary local trial only. Production should validate Twilio signatures using TWILIO_AUTH_TOKEN.
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_AUTH_TOKEN=

# Governed conversation model: Sarvam
SARVAM_API_KEY=replace_me
SARVAM_CHAT_MODEL=sarvam-30b

# Future production telephony option: Plivo (not used by the validation server yet)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# Razorpay (use Test Mode keys for full payment E2E; placeholders are enough for voice-only validation)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder

# Google Calendar (real token required when testing live slot lookup/booking)
GOOGLE_CALENDAR_ACCESS_TOKEN=placeholder
GOOGLE_CALENDAR_ID=primary

# Single-tenant V0 dental validation configuration
TEST_TENANT_ID=demo-dental-hospital
ADMIN_API_KEY=local_validation_only
APPOINTMENT_MINUTES=30
BUSINESS_DAY_START_HOUR=9
BUSINESS_DAY_END_HOUR=18
CALENDAR_HORIZON_DAYS=7
STAFF_NOTIFY_PHONE=

# Load config/dental-demo.json into TENANT_CONFIG_JSON at runtime.
# Never commit real API keys, patient/customer data, or personal phone numbers.
